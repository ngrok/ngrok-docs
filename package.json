{
  "name": "ngrok-docs-v2",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "fetch-k8s-changelog": "node custom/scripts/fetch-k8s-changelog.js",
    "dev": "mint dev --port 3333",
    "check-redirect-conflicts": "node custom/scripts/check-redirect-conflicts.js",
    "test-links": "mint broken-links",
    "vale": "PATH=\"$PWD/scripts/vale:$PATH\" vale --glob='!{snippets/api/**,snippets/errors/**,snippets/obs/**,snippets/k8s/_changelog.mdx,snippets/k8s/_helm-config.mdx,errors/**,.skills/**,gateway/agent/cli-api.mdx,gateway/agent/cli.mdx,style-guide.mdx}' .",
    "postinstall": "bash custom/scripts/glossary/install-hook.sh"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.14.0",
  "pnpm": {
    "overrides": {
      "react": "19.2.4"
    }
  },
  "dependencies": {
    "@babel/parser": "^8.0.6",
    "@babel/traverse": "^8.0.6",
    "@types/react": "^19.1.13",
    "gray-matter": "^4.0.3",
    "js-yaml": "^5.4.2",
    "mint": "^4.2.942",
    "mdx2vast": "^0.5.0",
    "react": "^19.1.1",
    "react-markdown": "^10.1.0"
  }
}