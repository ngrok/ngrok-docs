{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ngrok AI Gateway translation limitations",
  "description": "Explanations of what a translated request loses or changes, each with the translation matrix rows it explains. Generated by `nd gen docs` in the ngrok monorepo.",
  "type": "object",
  "required": ["schema_version", "items"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "items": { "type": "array", "items": { "$ref": "#/$defs/limitation" } }
  },
  "$defs": {
    "limitation": {
      "type": "object",
      "required": ["id", "title", "body_md", "evidence"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "title": { "type": "string", "minLength": 1 },
        "body_md": { "type": "string", "minLength": 1, "description": "The explanation, in Markdown." },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/selector" },
          "description": "Each selector matches the translation matrix rows that show the limitation."
        }
      }
    },
    "selector": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "description": "Matches each row whose fields equal every field the selector sets.",
      "properties": {
        "source": { "type": "string" },
        "target": { "type": "string" },
        "field": { "type": "string" },
        "case": { "type": "string" },
        "outcome": { "type": "string" },
        "reason": { "type": "string" }
      }
    }
  }
}
