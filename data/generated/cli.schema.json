{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ngrok agent CLI",
  "description": "The ngrok agent command tree. Generated by `nd gen docs` in the ngrok monorepo.",
  "type": "object",
  "required": ["schema_version", "items"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "items": {
      "type": "array",
      "description": "The root command. It has exactly one item.",
      "minItems": 1,
      "maxItems": 1,
      "items": { "$ref": "#/$defs/command" }
    }
  },
  "$defs": {
    "command": {
      "type": "object",
      "required": ["full_name", "short_name", "short_description", "docs_link", "flags", "sub_commands"],
      "additionalProperties": false,
      "properties": {
        "full_name": { "type": "string", "description": "The full command, for example \"ngrok http\".", "minLength": 1 },
        "short_name": { "type": "string", "minLength": 1 },
        "short_description": { "type": "string" },
        "long_description": { "type": "string" },
        "example": { "type": "string" },
        "usage": { "type": "string" },
        "deprecated": { "type": "string", "description": "The deprecation notice. Absent when the command is not deprecated." },
        "docs_link": { "type": "string" },
        "flags": { "type": ["array", "null"], "items": { "$ref": "#/$defs/flag" } },
        "sub_commands": { "type": ["array", "null"], "items": { "$ref": "#/$defs/command" } }
      }
    },
    "flag": {
      "type": "object",
      "required": ["full_name", "short_name", "description"],
      "additionalProperties": false,
      "properties": {
        "full_name": { "type": "string", "minLength": 1 },
        "short_name": { "type": "string" },
        "description": { "type": "string" },
        "deprecated": { "type": "string", "description": "The deprecation notice. Absent when the flag is not deprecated." }
      }
    }
  }
}
